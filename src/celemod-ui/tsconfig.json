{
  "compilerOptions": {
    "baseUrl": ".",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react",
    "jsxFactory": "h",
    "lib": [
      "dom",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "locales/*": ["locales/*"],
      "src/*": ["src/*"]
    },
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",
    "vite.config.ts"
  ]
}
