{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CeleMod",
  "version": "1.0.0",
  "identifier": "com.celemod.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../src/celemod-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CeleMod",
        "width": 800,
        "height": 640,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../resources/icon.png",
      "../resources/icon.icns",
      "../icon.ico"
    ]
  }
}
