{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CeleMod",
  "version": "1.1.6",
  "identifier": "com.celemod.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../src/celemod-ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "CeleMod",
        "width": 1100,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "backgroundColor": [19, 19, 19, 255],
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["celemod"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../resources/icon.png", "../resources/icon.icns", "../icon.ico"]
  }
}
